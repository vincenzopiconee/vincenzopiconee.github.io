---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  {
    name: 'GitHub',
    handle: 'github.com/vincenzopiconee',
    description: 'Browse source code, commits, and ongoing Swift experiments.',
    href: 'https://github.com/vincenzopiconee',
    external: true,
  },
  {
    name: 'LinkedIn',
    handle: 'linkedin.com/in/vincenzo-piconee',
    description: 'Follow my studies, fellowships, and professional path.',
    href: 'https://www.linkedin.com/in/vincenzo-piconee',
    external: true,
  },
  {
    name: 'Email',
    handle: 'vincenzopicone22@gmail.com',
    description: 'Say hello about internships, collaborations, or new app ideas.',
    href: 'mailto:vincenzopicone22@gmail.com',
    external: false,
  },
];
---

<BaseLayout
  title="Profile | Vincenzo Picone"
  description="About Vincenzo Picone: background, Apple Developer Academy fellowship, Human-Computer Interaction studies, and ways to connect."
  activeNav="profile"
>
  <article class="apple-container pt-14 pb-16 sm:pt-24">
    <a href="/" class="apple-link text-sm font-medium">
      &lsaquo; Back to Projects
    </a>

    <!-- Profile Intro: 50/50 Split (Left Half = Centered Circular Portrait, Right Half = Name) -->
    <header class="mt-10 grid grid-cols-1 items-center gap-10 md:grid-cols-2">
      <div class="flex justify-center">
        <img
          src="/media/profile.jpg"
          alt="Vincenzo Picone"
          width="640"
          height="640"
          loading="eager"
          decoding="async"
          class="h-56 w-56 rounded-full object-cover object-center shadow-md ring-1 ring-[var(--hairline)] sm:h-64 sm:w-64 lg:h-[300px] lg:w-[300px]"
        />
      </div>

      <div>
        <h1 class="text-5xl font-semibold tracking-[-0.035em] text-[var(--ink)] sm:text-6xl">
          Vincenzo Picone
        </h1>
        <p class="mt-4 max-w-lg text-xl font-medium leading-relaxed text-[var(--ink-secondary)] sm:text-2xl">
          Computer Science student crafting native iOS apps with Swift and SwiftUI.
        </p>
      </div>
    </header>

    <!-- About Me -->
    <section class="mt-14 grid gap-10 border-t border-[var(--hairline)] pt-12 lg:grid-cols-[30%_1fr]">
      <h2 class="text-2xl font-semibold tracking-tight text-[var(--ink)]">
        About me
      </h2>

      <div class="max-w-4xl space-y-5 text-base leading-relaxed text-[var(--ink-secondary)] sm:text-lg">
        <p>
          My path into Apple development took shape in Naples during the Apple Developer Academy at the University of Naples Federico II. Over nine months of Challenge-Based Learning, I took concepts from early prototypes in Figma all the way to full-cycle apps tested on TestFlight across iOS, iPadOS, watchOS, and visionOS.
        </p>
        <p>
          Today, I am pursuing a European double master's in Human-Computer Interaction and Design between Politecnico di Milano and Universidad Polit&eacute;cnica de Madrid. That blend of engineering and interaction design guides how I build: whether bridging UIKit for Quick Look editing, tuning ImageIO thumbnail memory, or wiring peer-to-peer sessions over local Wi-Fi, I care as much about how software feels in someone's hands as how it runs underneath.
        </p>
        <p>
          I enjoy working with international teams, watching real users test early builds, and diving into unfamiliar corners of Apple's SDKs whenever an idea calls for it. I deliberately choose ambitious goals to keep pushing myself forward, turning tough technical and design challenges into products I am proud to ship.
        </p>
      </div>
    </section>

    <!-- Full-Width Spacious Contact Cards (Single-Line Links) -->
    <section class="mt-16 border-t border-[var(--hairline)] pt-12" aria-labelledby="connect-heading">
      <div>
        <h2 id="connect-heading" class="text-2xl font-semibold tracking-tight text-[var(--ink)]">
          Connections
        </h2>
        <p class="mt-2 text-sm text-[var(--ink-secondary)]">
          Always happy to connect, talk Apple platforms, or collaborate on something new.
        </p>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3">
        {links.map((item) => (
          <a
            data-dynamic-card
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class="dynamic-card flex min-h-[185px] flex-col justify-between overflow-hidden rounded-[26px] p-7 sm:p-8"
          >
            <div class="card-spotlight" aria-hidden="true"></div>
            <div class="relative z-10">
              <p class="text-xl font-semibold tracking-tight text-[var(--ink)]">{item.name}</p>
              <p class="mt-2 text-sm leading-relaxed text-[var(--ink-secondary)]">
                {item.description}
              </p>
            </div>
            <p class="apple-link relative z-10 mt-7 whitespace-nowrap text-sm font-medium">
              {item.handle} &rsaquo;
            </p>
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
